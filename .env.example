# 复制为 .env 后填入真实值（.env 已被 git 忽略，不会提交）
# 企业微信管理后台 → 我的企业 → 企业信息 可获取 corpid
WECOM_CORP_ID=ww059a8dadfd559537

# 自建应用 Secret（管理后台 → 应用管理 → 对应应用 → Secret）
WECOM_SECRET=
# 通讯录 Secret（用于改 userid 等通讯录接口，可选；不需要可留空）
WECOM_CONTACTS_SECRET=

# 应用 agentid
WECOM_AGENT_ID=1000004

# 二维码管理员 userid（扫码后用于提醒该管理员更新二维码）
WECOM_QR_ADMIN_USERID=zhengfei

# 回调配置（管理后台 → 应用 → 接收消息 → 设置API接收）
# 企业微信提供的 Token 与 EncodingAESKey
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# 后台管理页登录密码（访问 /admin 时需要）
ADMIN_PASSWORD=

# 监听端口（Docker 内固定 18081，无需修改）
PORT=18081

# 若通过 nginx 等反向代理访问，设为 1 以正确获取客户端真实 IP
TRUST_PROXY=1

{
  "name": "t3-wecom-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone webhook relay for WeCom application messages (Node + Cloudflare Workers)",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "check": "node --check server.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@wecom/crypto": "^1.0.1",
    "fast-xml-parser": "^5.7.0"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
